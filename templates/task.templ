package templates

import (
	"fmt"
	"sqlite/model"
)

templ Task(task model.Task) {
	@Layout("Edit task", true) {
		<div class="form-container scrollable-content">
			<form id="task-form" method="post" action={ templ.URL(fmt.Sprintf("/tasks/%d", task.ID)) } class="spaced xlarge">
				<div class="header-row">
					<div class="breadcrumb">
						<a href="/tasks">back to tasks</a>
					</div>
					<div class="menu-container">
						<button
							type="button"
							id="menu-button"
							class="menu-button"
							aria-label="Menu"
						>
							<span class="hamburger">☰</span>
						</button>
						<div id="context-menu" class="context-menu">
							<ul>
								<li>
									<button
										type="button"
										class="menu-item delete"
										id="delete-button"
									>
										Delete
									</button>
								</li>
							</ul>
						</div>
					</div>
				</div>
				<div>
					<label for="title">Title</label>
					<input type="text" name="title" value={ task.Title } autofocus/>
				</div>
				<div>
					<label for="description">Description</label>
					<textarea name="description" id="description">{ task.Description }</textarea>
				</div>
			</form>
		</div>
		<dialog id="delete-dialog">
			<form method="post" action={ templ.URL(fmt.Sprintf("/tasks/%d/delete", task.ID)) } class="spaced large">
				<h3>Delete task</h3>
				<p>Are you sure you want to delete this task?</p>
				<div class="form-buttons">
					<button type="button" class="cancel">Cancel</button>
					<button id="confirm-delete" type="submit">Delete</button>
				</div>
			</form>
		</dialog>
		<script type="module" src="/assets/task.js"></script>
	}
}
